<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShellDemo.Pages.EditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Edycja">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label x:Name="InfoLabel" FontSize="14" TextColor="Gray" />
        <Entry x:Name="NameEntry" Placeholder="Nazwa" />

        <Button Clicked="OnSaveClicked" Text="Zapisz i wróć (..)" />
    </VerticalStackLayout>

</ContentPage>
